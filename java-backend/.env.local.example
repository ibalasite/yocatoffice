# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example — complete environment-variable reference for yocat-office-backend
# (O-17). Source of truth: apps/api/src/main/resources/application.yml (every ${VAR}
# below has a matching placeholder there), cross-checked with k8s/overlays/local/
# kustomization.yaml (ConfigMap + Secret keys) and docker-compose.yml.
#
# Usage (host-direct run, outside k8s):
#   cp .env.local.example .env.local
#   # edit the values marked REQUIRED, then export and run:
#   set -a; . ./.env.local; set +a
#   mvn -pl apps/api spring-boot:run
#
# Deployment paths that do NOT read this file (it is a reference/host-run template):
#   - K8s:    values come from the ConfigMap + Secret (k8s/overlays/local/).
#             App config keys mirror this file 1:1; secrets via scripts/bootstrap-secrets.sh.
#   - Compose: docker-compose.yml hardcodes the service-internal values and only reads
#             DB_PASSWORD from ./.env (see .env.example, the Compose host-override).
#
# Defaults shown are the DEV-FRIENDLY local values. The in-cluster value that the
# application.yml placeholder actually falls back to is noted per entry where it differs.
# Every value here is a safe placeholder — NEVER commit a real secret. .env / .env.local
# / secrets.env are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# === Spring runtime ===
# Purpose: active Spring profile; selects log format (JSON for dev|staging|prod, console for local|test)
#          and profile-specific wiring (platform-server-bootstrap logback-spring.xml).
# Example: local | dev | staging | prod | test
# K8s ConfigMap sets this to "local".
SPRING_PROFILES_ACTIVE=local

# === Server ===
# Purpose: HTTP port the embedded server binds (application.yml server.port).
# Example: 8080
# REQUIRED IN PROD: set per the EDD §3.5 service-port table / ingress target.
SERVER_PORT=8080

# === Database (PostgreSQL) ===
# NOTE: the JDBC port is fixed at 5432 inside the URL in application.yml (there is no DB_PORT
#       variable). Point DB_HOST at a Postgres reachable on 5432 — e.g. for the local yocat-pg:
#       kubectl -n yocat port-forward svc/yocat-pg 5432:5432
#
# Purpose: database host (application.yml datasource url).
# Example: localhost
# In-cluster ConfigMap value: yocat-pg.yocat.svc.cluster.local
DB_HOST=localhost
#
# Purpose: database name (application.yml datasource url).
# Example: yocat
# application.yml fallback default is yocat_office; the deployed yocat-pg DB is "yocat".
DB_NAME=yocat
#
# Purpose: database user (application.yml datasource username).
# Example: yocat
# application.yml fallback default is yocat.
DB_USER=yocat
#
# Purpose: database password (application.yml datasource password).
# Example: changeme
# SENSITIVE — COMPLIANCE: the DB stores member PII (email) + wallet ledger; protect this credential.
# REQUIRED IN PROD: supply via the k8s Secret (scripts/bootstrap-secrets.sh), never inline.
DB_PASSWORD=changeme

# === Cache (Redis) ===
# Purpose: Redis host (application.yml spring.data.redis.host).
# Example: localhost
# In-cluster ConfigMap value: redis (application.yml default: redis.yocat-office-backend-local.svc)
REDIS_HOST=localhost
#
# Purpose: Redis port (application.yml spring.data.redis.port).
# Example: 6379
REDIS_PORT=6379
#
# Purpose: Redis AUTH password (application.yml yocat.cache.redis.password).
# Example: (empty = no AUTH for a local standalone Redis)
# SENSITIVE — REQUIRED IN PROD: set the managed-Redis AUTH secret via the k8s Secret (EDD §7.5/§13.6).
REDIS_PASSWORD=
#
# Purpose: {env} key-namespace prefix for all cache keys (application.yml yocat.cache.env, EDD §11.3A/§21.3).
# Example: local | dev | staging | prod
CACHE_ENV=local
#
# Purpose: API→Redis command timeout in ms (application.yml yocat.cache.redis.timeout-ms, EDD §4.5.9).
# Example: 500
REDIS_TIMEOUT_MS=500
#
# Purpose: enable {bc} hash-tag key wrapping for Redis Cluster mode (application.yml, ARCH §7).
# Example: false (standalone) | true (Cluster)
REDIS_CLUSTER_HASH_TAG=false
#
# Purpose: Lettuce connection-pool max active connections / bulkhead (application.yml, EDD §11.2).
# Example: 16
REDIS_POOL_MAX_ACTIVE=16
#
# Purpose: Lettuce connection-pool max idle connections (application.yml).
# Example: 16
REDIS_POOL_MAX_IDLE=16
#
# Purpose: Lettuce connection-pool min idle connections (application.yml).
# Example: 4
REDIS_POOL_MIN_IDLE=4
#
# Purpose: Redis Sentinel master name; empty = standalone (application.yml, EDD §3.6).
# Example: (empty locally) | mymaster
REDIS_SENTINEL_MASTER=
#
# Purpose: comma-separated Sentinel host:port nodes for HA; empty = standalone (application.yml, EDD §7.3).
# Example: (empty locally) | sentinel-0:26379,sentinel-1:26379,sentinel-2:26379
REDIS_SENTINEL_NODES=

# === Observability ===
# Purpose: distributed-tracing sample probability (application.yml management.tracing.sampling, EDD §10.2).
# Example: 1.0 (local=100%)
# REQUIRED IN PROD: lower to 0.1 (10%) per EDD §10.2.
TRACE_SAMPLE=1.0

# === Ops / feature-flag seeding ===
# Purpose: feature-flag provider selector read by scripts/feature-flag-seed.sh. Empty = built-in
#          DB engine (platform.feature_flags table, archConfig.feature_flag_provider=''). Not read
#          by the Spring app at runtime.
# Example: (empty = builtin DB)
FEATURE_FLAG_PROVIDER=

# === Reserved secrets (carried in the k8s Secret for seed/ops; NOT read by the app yet) ===
# These are generated by scripts/bootstrap-secrets.sh and mirrored in
# k8s/overlays/local/secrets.example.env. Listed here for operator completeness; the running
# Spring application does not yet resolve them. Keep in the Secret, never in ConfigMap/source.
#
# Purpose: HMAC key reserved for future signed-session/token use.
# Example: <generated-by-bootstrap-secrets.sh: openssl rand -hex 64>
# SENSITIVE — REQUIRED IN PROD if session signing is enabled.
SESSION_SIGNING_KEY=changeme
#
# Purpose: data-at-rest encryption key reserved for future PII field encryption.
# Example: <generated-by-bootstrap-secrets.sh: openssl rand -hex 32>
# SENSITIVE — COMPLIANCE: PII protection (member data); REQUIRED IN PROD if field encryption is enabled.
ENCRYPTION_KEY=changeme
#
# Purpose: initial admin bootstrap password reserved for ops seeding.
# Example: <generated-by-bootstrap-secrets.sh: openssl rand>
# SENSITIVE — REQUIRED IN PROD if an admin bootstrap flow is enabled.
ADMIN_INIT_PASSWORD=changeme
