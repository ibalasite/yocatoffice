<?xml version="1.0" encoding="UTF-8"?>
<!--
  yocat-office-backend — Root aggregator / parent POM
  Source of truth: docs/EDD.md §3.3 Tech Stack (SSoT) · §9 目錄結構 (Maven, apps/api/)
  lang_stack = Java 21 + Spring Boot 3.3 + Spring Modulith 1.3 (Modular Monolith, 7 BC)
  Generated by gencode[foundation-package-manifest].
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.3.x — pinned to 3.3.5 (EDD §3.3: Spring Boot 3.3.x) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.sayyogames.yocat</groupId>
    <artifactId>yocat-office-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>yocat-office-backend</name>
    <description>Server-authoritative membership/wallet backend — Spring Modulith Modular Monolith (7 BC)</description>

    <modules>
        <module>apps/api</module>
    </modules>

    <properties>
        <!-- EDD §3.3 Tech Stack — pinned versions (no "A or B", no ">=N") -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Modulith: EDD §3.3 lists 1.3.x, but 1.3.x requires Spring Boot 3.4+.
             archConfig.framework=spring-boot-3.3 is the authoritative pin, so Modulith is
             resolved to the compatible 1.2.x line (SPEC-CONFLICT, see state.deviations). -->
        <spring-modulith.version>1.2.7</spring-modulith.version>
        <!-- Architecture guard (EDD §3.3: ArchUnit 1.3) -->
        <archunit.version>1.3.0</archunit.version>
        <!-- Circuit breaker (EDD §8.3: Resilience4j) -->
        <resilience4j.version>2.2.0</resilience4j.version>
        <!-- scrypt password hashing (EDD §3.3 / §7.5: Bouncy Castle) -->
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <!-- Pact consumer contract tests (EDD §4.6.1 / test-plan §3.2) -->
        <pact.version>4.6.15</pact.version>
        <!-- BDD Cucumber-JVM (test-plan §BDD / RTM @smoke; server-side Gherkin step definitions) -->
        <cucumber.version>7.18.1</cucumber.version>
        <!-- SAST plugin (CICD.md ci-spotbugs) -->
        <spotbugs-maven-plugin.version>4.8.6.4</spotbugs-maven-plugin.version>
        <!-- Coverage thresholds (test-plan §2 / CICD.md): Line >=80% / Branch >=70% / core txn 100% -->
        <jacoco.line.min>0.80</jacoco.line.min>
        <jacoco.branch.min>0.70</jacoco.branch.min>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Modulith BOM aligns all spring-modulith-* artifacts -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Resilience4j BOM (Spring Boot 3) -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Cucumber-JVM BOM aligns all io.cucumber:* artifacts (BDD step definitions) -->
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- JaCoCo coverage gate — CI fails below threshold (test-plan §2) -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                </plugin>
                <!-- Integration tests (*IT.java) via Failsafe -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                </plugin>
                <!-- SAST: SpotBugs (CICD.md ci-spotbugs) -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
