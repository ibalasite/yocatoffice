<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sayyogames.yocat</groupId>
        <artifactId>yocat-office-backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>yocat-office-backend-api</artifactId>
    <packaging>jar</packaging>
    <name>yocat-office-backend-api</name>
    <description>REST API server (Port 8080) — member/wallet/deposit/entitlement/record/leaderboard/gamesave</description>

    <dependencies>
        <!-- ══ Web / API Framework (EDD §3.3: Spring Boot 3.3.x) ══ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bean Validation (EDD §3.3 / API 輸入驗證) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ══ ORM / Data Access (EDD §3.3: Spring Data JDBC 3.3.x) ══ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <!-- PostgreSQL 16 driver (EDD §3.3) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ══ Cache (EDD §3.3: Redis 7.2 — session/rate-limit/leaderboard cache) ══ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce connection pool (EDD §11.2 Bulkhead: Redis pool=16); not bundled by the starter -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ══ AuthN/AuthZ (EDD §3.3: Spring Security 6.3.x — Bearer opaque session, RBAC) ══ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Password hashing: scrypt via Bouncy Castle (EDD §3.3 / §7.5: SCryptPasswordEncoder, keylen 64) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- ══ Spring Modulith 1.3.x (EDD §3.3: @ApplicationModule 邊界 + Event Registry Outbox) ══ -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <!-- Transactional Outbox: Event Publication Registry (JDBC) — spring.modulith.events.jdbc.enabled -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-jdbc</artifactId>
        </dependency>

        <!-- ══ Resilience / Circuit Breaker (EDD §8.3: Resilience4j) ══ -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>

        <!-- ══ Observability (EDD §10.1/§10.2) ══ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Metrics: Micrometer → Prometheus (/actuator/prometheus) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Distributed tracing: Micrometer Tracing bridge → OpenTelemetry (OTLP → Tempo/Jaeger) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ══ Unit Test (EDD §3.3: JUnit 5 + Mockito) ══ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ══ Architecture guard (EDD §3.3: ArchUnit + Spring Modulith verify()) ══ -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ══ Integration / E2E (EDD §3.3: Testcontainers PostgreSQL+Redis + REST-assured) ══ -->
        <!-- Boot Testcontainers support (@ServiceConnection) — versions managed by Spring Boot BOM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Redis testcontainer: core org.testcontainers GenericContainer (6379) — no extra artifact required -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- REST-assured — HTTP contract/E2E assertions -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ══ Consumer-Driven Contract (EDD §4.6.1 / test-plan §3.2: Pact) ══ -->
        <dependency>
            <groupId>au.com.dius.pact.consumer</groupId>
            <artifactId>junit5</artifactId>
            <version>${pact.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ══ BDD: Cucumber-JVM (test-plan §BDD; features/**/*.feature → server-side step definitions) ══ -->
        <!-- Gherkin step glue -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring DI for step objects: @CucumberContextConfiguration + @ScenarioScope beans -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Runs Cucumber under the JUnit Platform (discovered by the @Suite runner, Failsafe *IT) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @Suite aggregator that selects the classpath:features resources (version via Boot junit-bom) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>yocat-office-backend-api</finalName>
        <plugins>
            <!-- Executable Spring Boot jar + spring-boot:run (dev) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.sayyogames.yocat.YocatOfficeBackendApplication</mainClass>
                </configuration>
            </plugin>

            <!-- Unit tests: *Test.java via Surefire -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Integration tests: *IT.java via Failsafe (Testcontainers, REST-assured, Modulith) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- JaCoCo coverage gate — Line >=80% / Branch >=70% / core txn use cases =100% line
                 (test-plan §2 / §3.1 覆蓋率目標; CICD.md §2.1/§4.1).
                 Coverage is measured over the FULL test run (unit Surefire + integration
                 Failsafe/Testcontainers) and the two exec files are MERGED before report+check,
                 because test-plan §3.1 routes <<Controller>> coverage to §3.2 MockMvc/RestAssured
                 and <<RepositoryImpl>>/Infrastructure/Cache coverage to the Integration layer — a
                 unit-only check would contradict §3.1's own layer routing and under-report. The
                 enforcing `check` therefore runs at `verify` (the integration stage, make
                 ci-test-integration); the unit stage still emits a fast unit-only report. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- Excluded from the coverage target per test-plan §3.1: the Spring Boot
                         bootstrap class and @Configuration wiring beans (no business logic), and
                         <<Controller>> + nested <<RequestDTO>>/<<ResponseDTO>> records (trivial
                         delegation, contract-verified by §3.2). Domain + Application main logic is
                         NEVER excluded (anti-fake: no `/src/`-wide ignore, no main-logic masking). -->
                    <excludes>
                        <exclude>**/YocatOfficeBackendApplication.class</exclude>
                        <exclude>**/*Config.class</exclude>
                        <exclude>**/*BeansConfig.class</exclude>
                        <exclude>**/presentation/**</exclude>
                        <exclude>**/platform/web/HealthController.class</exclude>
                        <!-- <<RepositoryImpl>> is routed to §3.2 Integration and NOT counted in the
                             coverage target (test-plan §3.1: "RepositoryImpl 列入 §3.2 Integration，
                             不計入覆蓋率"). Its behaviour is verified by the Jdbc*RepositoryIT suite. -->
                        <exclude>**/infrastructure/Jdbc*Repository.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Unit coverage agent (Surefire) -> target/jacoco.exec -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Integration coverage agent (Failsafe/Testcontainers) -> target/jacoco-it.exec -->
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <!-- Fast unit-only report at test phase (dev feedback + unit-test job artifact) -->
                    <execution>
                        <id>report-unit</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- Unit-stage gate: core wallet/entitlement txn use cases =100% line, provable
                         by the unit suite alone (SpendWallet/TopUp/BuyEntitlementUseCaseTest).
                         Keeps make ci-test-unit a real JaCoCo gate; the bundle Line/Branch floor is
                         enforced on merged data at verify (CICD §2.1 unit vs integration split). -->
                    <execution>
                        <id>coverage-check-core-unit</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.sayyogames.yocat.wallet.application.SpendWalletUseCase</include>
                                        <include>com.sayyogames.yocat.wallet.application.TopUpWalletUseCase</include>
                                        <include>com.sayyogames.yocat.entitlement.application.BuyEntitlementUseCase</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <!-- Merge unit + integration exec files before the aggregate report/gate -->
                    <execution>
                        <id>merge-exec</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <!-- Aggregate report: HTML (devs) + XML (CI/Codecov) + CSV (dashboards) are all
                         produced by the report goal; consumed by CI upload-artifact (CICD §2.1). -->
                    <execution>
                        <id>report-merged</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- Coverage gate on the MERGED data (fails the build below threshold) -->
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <rules>
                                <!-- Bundle-wide floor: Line >=80% / Branch >=70% (test-plan §3.1, CICD §2.1) -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Core wallet/entitlement transaction use cases: 100% line
                                     (test-plan §2/§3.1; class names verified against source) -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.sayyogames.yocat.wallet.application.SpendWalletUseCase</include>
                                        <include>com.sayyogames.yocat.wallet.application.TopUpWalletUseCase</include>
                                        <include>com.sayyogames.yocat.entitlement.application.BuyEntitlementUseCase</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- SAST: SpotBugs (CICD.md ci-spotbugs; High/Critical gate) -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
