# secrets.example.env — variable-name source of truth for the app Secret (LOCAL_DEPLOY §18).
# Copy to secrets.env for a throwaway local run:  cp secrets.example.env secrets.env
# Real local values are generated by scripts/bootstrap-secrets.sh (openssl rand); secrets.env is gitignored.
# NEVER commit real secrets. These are dummy local sample values only.
DB_PASSWORD=change-me-local-only
SESSION_SIGNING_KEY=change-me-local-only
ENCRYPTION_KEY=change-me-local-only
ADMIN_INIT_PASSWORD=change-me-local-only
