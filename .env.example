# =============================================================================
# yoCat Office 後端信任層（yocat-office-backend）— .env.example
# -----------------------------------------------------------------------------
# Spring Boot 3.3 + PostgreSQL 16（namespace yocat / yocat-pg / NodePort 30432）
#   + Redis 7.2 技術棧。本檔為「變數名稱 + 安全佔位值」範本。
#
# 用法：  cp .env.example .env.local   後填入真實值（.env.local 已被 .gitignore）
#
# 變數來源：docs/LOCAL_DEPLOY.md §9（ConfigMap yocat-office-backend-api-config
#           + Secret yocat-office-backend-api-secret）、§3.5 Secret Bootstrap。
#
# ⚠️ 本檔只放佔位值，禁止提交任何真實密碼 / 金鑰。
#    真實本機假密碼請用 scripts/bootstrap-secrets.sh（openssl rand）生成。
# =============================================================================

# --- Spring 執行設定（ConfigMap） -------------------------------------------
SPRING_PROFILES_ACTIVE=local                 # Spring profile：local / staging / prod
SERVER_PORT=8080                             # API 監聽 port（容器內 8080）

# --- PostgreSQL 連線（ConfigMap + Secret） ----------------------------------
# inner-loop（host 跑 Spring Boot）：用 NodePort localhost:30432
# in-cluster（Pod 內）：改用 jdbc:postgresql://yocat-pg.yocat.svc.cluster.local:5432/yocat
DATABASE_URL=jdbc:postgresql://localhost:30432/yocat   # PostgreSQL JDBC URL（db=yocat）
DATABASE_USER=yocat                           # DB 使用者（既有 yocat-pg，user=yocat）
DATABASE_PASSWORD=change-me-local-only       # DB 密碼（須與 yocat-pg Secret 一致；勿提交）

# --- Redis 連線（ConfigMap） ------------------------------------------------
# inner-loop（host）：localhost:30379；in-cluster（Pod）：host=redis port=6379
REDIS_HOST=localhost                         # Redis service DNS / host
REDIS_PORT=30379                             # Redis port（NodePort 30379 / 容器內 6379）

# --- Session / 安全金鑰（Secret） -------------------------------------------
SESSION_TTL_DAYS=30                          # opaque session token TTL（天，EDD ADR-003）
SESSION_SIGNING_KEY=change-me-local-only     # opaque session 簽署金鑰（openssl rand -hex 64）
ENCRYPTION_KEY=change-me-local-only          # 敏感欄位加密金鑰（openssl rand -hex 32）
ADMIN_INIT_PASSWORD=change-me-local-only     # 初始 OPS 帳號密碼（seed 用；CSPRNG）

# --- 觀測性（ConfigMap） ----------------------------------------------------
LOG_LEVEL=DEBUG                              # 日誌等級：DEBUG / INFO / WARN / ERROR
